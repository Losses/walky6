+pub async fn render_frontpage_with_store(
+    store: &mut PersistentStore,
+    order: &str,
+) -> Result<String> {
+    let order_enum = match order {
+        "/oldest" => FrontPageOrder::Oldest,
+        "/newest" => FrontPageOrder::Newest,
+        "/sneakiest" => FrontPageOrder::Sneakiest,
+        _ => FrontPageOrder::Domain,
+    };
+    let mut buffer = Buffer::new();
+    render_frontpage(store, order_enum, &mut buffer).await?;
+    Ok(buffer.rendered().as_inner().to_string())
+}
+
+pub async fn get_entry_with_store(
+    store: &mut PersistentStore,
+    subspace_hex: &str,
+    entry_path: &str,
+) -> Result<Option<(String, Vec<u8>, String)>> {
+    let decoded = base16::decode(subspace_hex)
+        .map_err(|_| anyhow::anyhow!("invalid subspace hex"))?;
+    if decoded.len() != 32 {
+        anyhow::bail!("invalid subspace id length");
+    }
+    let subspace_id = SubspaceId::from_bytes(
+        decoded.as_array().expect("checked length above"),
+    );
+
+    let trimmed = entry_path.trim_start_matches('/');
+    let segments: Vec<&str> = trimmed.split('/').collect();
+    let segment_bytes: Vec<&[u8]> = segments
+        .into_iter()
+        .map(|s| if s.is_empty() { "index.html".as_bytes() } else { s.as_bytes() })
+        .collect();
+    let path = if segment_bytes.is_empty() {
+        Path::new()
+    } else {
+        Path::from_slices(&segment_bytes)?
+    };
+
+    let namespace = NamespaceId::from_bytes(&SNEAKERWEB_NAMESPACE_ID_BYTES);
+    let key = (subspace_id, path);
+
+    let entry = match store.get_entry(&namespace, &key, None).await? {
+        Some(e) => e,
+        None => return Ok(None),
+    };
+
+    let mime = mime_guess2::from_path(entry_path).first_or_octet_stream().to_string();
+    let etag = base16::encode_lower(entry.payload_digest().as_bytes());
+
+    let buf = Vec::new();
+    let cursor = std::io::Cursor::new(buf);
+    let writer = smol::Unblock::new(cursor);
+    let mut consumer = writer_to_bulk_consumer(writer, new_unbounded_elastic());
+    store
+        .get_payload_slice(&namespace, &key, None, 0, u64::MAX, &mut consumer)
+        .await?;
+
+    consumer.flush().await?;
+    let (mut writer, _queue) = consumer.into_inner();
+    writer.flush().await?;
+    let cursor = writer.into_inner().await;
+    let bytes = cursor.into_inner();
+
+    Ok(Some((mime, bytes, etag)))
+}
+
+pub async fn generate_frontpage_html(
